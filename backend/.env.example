DJANGO_DEBUG=true
DJANGO_SECRET_KEY=cambiar-en-cada-ambiente
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# true solo en un ambiente publicado con HTTPS (redirección, cookies seguras y HSTS)
DJANGO_HTTPS=false
# Sin DATABASE_URL se usa SQLite local
DATABASE_URL=postgres://nexora:nexora@localhost:5432/nexora
CORS_ALLOWED_ORIGINS=http://localhost:5173
